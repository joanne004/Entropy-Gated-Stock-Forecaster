# ── Local development (.env) ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env to Git.

# Groq API key — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Local Docker PostgreSQL (default, no change needed) ---
# Leave POSTGRES_HOST unset or set to "localhost"
# POSTGRES_HOST=localhost

# --- OR: Neon PostgreSQL (cloud) ---
# Set DATABASE_URL to override the local construction above.
# Get this from your Neon project dashboard → Connection string → psycopg2 format.
# DATABASE_URL=postgresql://user:pass@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- Streamlit (local only) ---
# If running streamlit locally while inference server is also local, leave unset.
# If inference server is deployed on Render, set to the Render URL:
# INFERENCE_SERVER_URL=https://stock-inference-server.onrender.com
